{
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env --env-file --allow-read src/server.ts",
    "start": "deno run --allow-net --allow-env --env-file --allow-read src/server.ts"
  },
  "compilerOptions": {
    "lib": [
      "ES2020",
      "deno.ns",
      "deno.window"
    ],
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@infrastructure/*": [
        "src/infrastructure/*"
      ],
      "@domain/*": [
        "src/domain/*"
      ],
      "@application/*": [
        "src/application/*"
      ],
      "@api/*": [
        "src/api/*"
      ]
    }
  },
  "imports": {
    "hono": "jsr:@hono/hono@^4.12.23",
    "hono/cors": "jsr:@hono/hono@^4.12.23/cors",
    "hono/logger": "jsr:@hono/hono@^4.12.23/logger",
    "typeorm": "npm:typeorm@^1.0.0",
    "reflect-metadata": "npm:reflect-metadata@^0.2.2",
    "pg": "npm:pg@^8.21.0"
  },
  "fmt": {
    "indentWidth": 4,
    "useTabs": true,
    "lineWidth": 160
  }
}